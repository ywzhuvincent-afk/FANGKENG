# ============================================================
# Avoid The Pit · 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# 永远不要 commit 真实的 .env.local!
# ============================================================

# ---- 应用 ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="避坑指南"
NODE_ENV="development"

# ---- 数据库 ----
# 本地开发:Docker PostgreSQL
DATABASE_URL="postgresql://postgres:atp@localhost:5432/avoidthepit?schema=public"
# 生产:Neon / Supabase 提供 connection string

# ---- 缓存 (Redis) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- 鉴权 (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# ---- 微信 OAuth (开放平台) ----
# https://open.weixin.qq.com/
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI="https://avoidthepit.com/api/auth/wechat/callback"

# ---- 微信公众号 ----
WECHAT_MP_APP_ID=""
WECHAT_MP_APP_SECRET=""
WECHAT_MP_TOKEN=""

# ---- Stripe ----
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# 启用 Stripe Tax 在 dashboard 里设置,代码里启用 automatic_tax: { enabled: true }

# ---- IP 地理 (Cloudflare 自带,无需 key,但要确保前面套了 Cloudflare) ----
# 备用方案:MaxMind
MAXMIND_LICENSE_KEY=""

# ---- 邮件 (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="hello@avoidthepit.com"

# ---- SMS (Twilio,老年模式警报用) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ---- 文件存储 (Cloudflare R2) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="avoidthepit-media"
R2_PUBLIC_URL=""

# ---- 错误监控 ----
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- 分析 ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---- 地图 (Phase 4+) ----
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---- AI (Phase 5,可选) ----
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---- 内部 ----
INTERNAL_API_TOKEN=""
ADMIN_EMAIL="admin@avoidthepit.com"
